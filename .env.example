# Port the server listens on (Railway sets this automatically)
PORT=3000

# Long, random string used to sign session cookies (make sure to change this!)
SESSION_SECRET=change-this-to-a-long-random-string

# Directory for the database file and uploaded files.
# Locally a relative path is fine. On Railway, point this at the mounted volume path (e.g. /data).
DATA_DIR=./data

# development | production
NODE_ENV=development
